#!/bin/bash
set -e

# Read secrets (Docker mounts them as file paths)
DB_USER=$(cat "${READINESS_DB_USER}")
DB_PASS=$(cat "${READINESS_DB_PASSWORD}")

# Required ENV variables
: "${db_host:?Need to set db_host}"
: "${db_name:?Need to set db_name}"

MONGO_URI="mongodb://${DB_USER}:${DB_PASS}@${db_host}/${db_name}?authSource=admin&replicaSet=replicaset"

TIMEOUT=600
START_TIME=$(date +%s)

echo "⏳ Waiting for MongoDB replica set to be fully ready..."
echo "Using URI: $MONGO_URI"

while true; do
  # Log detailed status of members
  echo "🔍 Checking replica set members..."
  mongosh "$MONGO_URI" --quiet --eval '
    rs.status().members.forEach(function(m) {
      print(m.name + " - " + m.stateStr + " - health: " + m.health);
    });
  '

  # Check readiness
  IS_READY=$(mongosh "$MONGO_URI" --quiet --eval '
    rs.status().members.every(function(m) {
      return ["PRIMARY", "SECONDARY"].includes(m.stateStr) && m.health === 1;
    });
  ')

  if [ "$IS_READY" = "true" ]; then
    echo "✅ Replica set is healthy. Continuing..."
    break
  fi

  # Check for timeout
  CURRENT_TIME=$(date +%s)
  if [ $((CURRENT_TIME - START_TIME)) -ge $TIMEOUT ]; then
    echo "❌ Timeout: MongoDB replica set not ready after $TIMEOUT seconds."
    exit 1
  fi

  echo "⏳ Not ready yet. Retrying in 3s..."
  sleep 3
done

# Execute passed command (e.g., `npm run start`)
exec "$@"