#1. base image that includes Chrome
#FROM zenika/alpine-chrome:with-node
FROM node:18.12.0-bullseye
#FROM davidjeddy/docker_puppeteer_jest
#FROM node:slim

#2. Create a work directory
WORKDIR /nodeApp

#3. Copy the depency information into the directory
COPY package.json package-lock.json ./

#4. Install all the dependencies
#RUN npm install -g npm
RUN npm install

#5. Copy all the code into the work directory
COPY . ./

#6. Script to wait for the database service before starting the app
RUN apt-get -q update && apt-get -qy install netcat
COPY wait-for /nodeApp/
RUN chmod +x /nodeApp/wait-for

# The build-time argument for the path to the .env.test file (default value if not provided)
ARG ENV_FILE_PATH=./configs/.env.test

# Copy the .env.test file to the appropriate location inside the container during build
COPY $ENV_FILE_PATH ./.env.test

#7. Set the application entry point
#ENTRYPOINT ["npm", "run", "devstart"]
ENTRYPOINT ["npm", "run", "test:unit-inside-docker"]
#ENTRYPOINT ["npm", "run", "test:e2e-inside-docker"]
#ENTRYPOINT ["sh", "-c", "npm run test:unit-inside-docker && npm run test:e2e-inside-docker"]
