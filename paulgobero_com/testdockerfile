#1. base image that includes Chrome
#FROM zenika/alpine-chrome:with-node
FROM node:18.12.0-bullseye
#FROM davidjeddy/docker_puppeteer_jest
#FROM node:slim

# 2. Install necessary system dependencies for Puppeteer
RUN apt-get update \
    && apt-get install -y libnss3-dev libgdk-pixbuf2.0-0 libgtk-3-0 libgbm-dev libasound2

# 3. Create a non-root user
RUN groupadd -r nodeuser && useradd -r -g nodeuser -G audio,video nodeuser \
    && mkdir -p /home/nodeuser/Downloads \
    && chown -R nodeuser:nodeuser /home/nodeuser

# 4. Set the work directory and permissions
WORKDIR /nodeApp
RUN chown -R nodeuser:nodeuser /nodeApp

# 5. Switch to the non-root user
USER nodeuser

# 6. Copy the dependency information into the directory
COPY package.json package-lock.json ./

# 7. Install all the dependencies
RUN npm install

# 8. Copy all the code into the work directory
COPY . ./

# 9. Change ownership of node_modules to the non-root user
USER root
RUN chown -R nodeuser:nodeuser /nodeApp/node_modules
USER nodeuser

# 10. Install netcat for wait-for script (already provided in the original Dockerfile)
RUN apt-get -qy install netcat

# 11. Copy the wait-for script into the work directory and make it executable
COPY wait-for /nodeApp/
RUN chmod +x /nodeApp/wait-for


# 12. Set the application entry point
#ENTRYPOINT ["npm", "run", "devstart"]
#ENTRYPOINT ["npm", "run", "test:unit-inside-docker"]
ENTRYPOINT ["npm", "run", "test:e2e-inside-docker"]
#ENTRYPOINT ["sh", "-c", "npm run test:unit-inside-docker && npm run test:e2e-inside-docker"]
