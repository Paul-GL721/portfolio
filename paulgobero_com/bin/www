#!/usr/bin/env node

/**
 * Module dependencies.
 */
const {
  DB_USER,
  DB_PASSWORD,
  DB_NAME,
  DB_HOST,
  DB_PORT,
  TEST_DB_USER,
  TEST_DB_PASSWORD,
  TEST_DB_NAME,
  TEST_DB_HOST,
  TEST_DB_PORT,
  TEST_NODE_PORT,
  NODE_PORT
} = require('../configs/config');

const database_connection = require('../configs/loadb');
const app = require('../app');
const debug = require('debug')('paulgobero-com:server');
const http = require('http');

/**
 * Environment
 */
const env = process.env.NODE_ENV || 'development';
console.log('env defined is', env);

/**
 * Port selection
 */
let port;

if (env === 'test') {
  port = normalizePort(TEST_NODE_PORT);
} else {
  port = normalizePort(NODE_PORT);
}

console.log('port is', port);
app.set('port', port);

/**
 * Bootstrap application
 * IMPORTANT: DB connection must succeed BEFORE server starts
 */
async function startServer() {
  try {
    if (env === 'test') {
      await database_connection(
        TEST_DB_NAME,
        TEST_DB_USER,
        TEST_DB_PASSWORD,
        TEST_DB_HOST,
        TEST_DB_PORT
      );
    } else {
      await database_connection(
        DB_NAME,
        DB_USER,
        DB_PASSWORD,
        DB_HOST,
        DB_PORT
      );
    }

    /**
     * Create HTTP server
     */
    const server = http.createServer(app);

    /**
     * Listen on provided port, on all network interfaces
     */
    server.listen(port, '0.0.0.0');
    server.on('error', onError);
    server.on('listening', () => onListening(server));

    console.log(`Server started successfully on port ${port}`);

  } catch (err) {
    console.error('❌ Application startup failed');
    console.error(err);
    process.exit(1); // REQUIRED for Docker Swarm / Traefik
  }
}

startServer();

/**
 * Normalize a port into a number, string, or false.
 */
function normalizePort(val) {
  const port = parseInt(val, 10);

  if (isNaN(port)) return val;
  if (port >= 0) return port;

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */
function onError(error) {
  if (error.syscall !== 'listen') throw error;

  const bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */
function onListening(server) {
  const addr = server.address();
  const bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
