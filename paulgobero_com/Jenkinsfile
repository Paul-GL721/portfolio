
//define variables
def staged_files
def testResult

pipeline {
	//run on different agents
	agent none

	//define env variables
	environment {
		VERSION="0.1.${BUILD_NUMBER}"
		BASE_DIRECTORY='paulgobero_com'
		REMOTE_USER='deployuser1'
		REMOTE_DIR='PORTFOLIO'
		REMOTE_FOLDER='paulgobero_com'
		STACKNAME='portfolio'
		GIT_REPO='git@github.com:Paul-GL721/portfolio.git'
		GH_TOKENCRED=credentials('jenkins-post-pr-portfolio')
		//GH_TOKENCRED=credentials('755f872e-4fbe-4127-93cd-8d917ac48242')
	}

	stages {
		stage('Merge development and staging branches') {
			//Execute if its the develpment branch
			when {
				branch 'development'
			}
			//where to execute
			agent {
				label 'buildnode'
			}
			steps {
				echo '..................Merging if anyfiles have changed................'
				
				//with github credentials stored in jenkins
				sshagent (credentials: ['e833b0c8-199a-4d54-a272-a021d20c622b']) {
					script {
						//make the build script executable
						sh 'chmod +x ./${BASE_DIRECTORY}/jenkins-scripts/merge-code-step.sh'

						//build the image
						sh '''./${BASE_DIRECTORY}/jenkins-scripts/merge-code-step.sh '''

						//Uncomment if they are changes made and commited to the staging branch directly
						//sh('git stash')
						//sh('git pull')
						//sh('git push ${GIT_REPO}')

						//Find the number of staged files
						staged_files = sh(script: 'git diff --cached --numstat | wc -l', returnStdout: true) as Integer

						//if they are (staged_files) more than zero, commit the files and push to remote repo
						if(staged_files > 0) {
							echo "They are ${staged_files} staged files"
							sh('git commit -m "Merged from development branch: Build version ${VERSION} " ')
							sh('git push ${GIT_REPO}')
						}
						else {
							echo "There no commits to make"
						}
					}
				}
			}
		}

		stage('Testing') {
			//Execute if its the staging branch
			when {
				branch 'staging'
			}
			//execute the code on the testing machine
			agent {
				label 'testnode'
			}
			steps {
				echo '..................Runing Tests................'
				//test code
				echo "Testing the code in the git repository"
			}
		}

		stage('Build and taged image') {
			//Execute if its the staging branch
			when {
				branch 'staging'
			}
			//build the docker image and push to dockerhub
			agent {
				//build on build agent
				label 'buildnode'
			}
			steps {
				echo '..............Building and Publishing Docker Images................'
				echo 'Creating a taged image'

				//make the build script executable
				//sh 'chmod +x ./${BASE_DIRECTORY}/jenkins-scripts/build-step.sh'

				//build the image
				//sh '''./${BASE_DIRECTORY}/jenkins-scripts/build-step.sh '''+VERSION+''' '''
			}
		}

		stage('Deploy on an EC2 instance') {
			//Execute if its the staging branch
			when {
				branch 'staging'
			}
			//Using ansible to deploy on an EC2 instance
			agent {
				label 'deploynode'
			}
			steps {
				echo '..................Deploying with ansible................'
				/*script{
					//run ansible-playbook
					sh "ansible-playbook ./${BASE_DIRECTORY}/ansible/portfolio-playbook.yml -i ./${BASE_DIRECTORY}/ansible/inventory.ini --extra-vars=\"{'REMOTE_USER': '${env.REMOTE_USER}', 'GIT_REPO': '${env.GIT_REPO}', 'REMOTE_DIR': '${env.REMOTE_DIR}', 'REMOTE_FOLDER': '${env.REMOTE_FOLDER}', 'STACKNAME': '${env.STACKNAME}', 'VERSION': '${env.VERSION}'}\" -vvv"
				}*/
			}
		}

		stage('Create pull request') {
			//Execute if its the staging branch
			when {
				branch 'staging'
			}
			//Use a docker image with gitcli installed
			agent {
				label 'buildnode'
				/*docker { 
					image 'paulgl721/githubcli:2.0.8'
					label 'buildnode'
					//args '-v ${HOME}:/root'
					//args '-v $(pwd):/githubcli'
					//args '-e GITHUB_TOKEN=$GITHUB_CLI_PSW'
					//args '-e GH_TOKEN=$GH_TOKENCRED_PSW'
				}*/
			}
			steps {
				echo '.............Creating pull request on production branch..........'

				//make the build script executable
				//sh 'chmod +x ./${BASE_DIRECTORY}/jenkins-scripts/pull-request-step.sh'

				//build the image
				//sh '''./${BASE_DIRECTORY}/jenkins-scripts/pull-request-step.sh '''
				sh 'git branch --all'
				sh 'git checkout -b tmpstagingv$VERSION remotes/origin/staging'
				sh 'git commit -m "Created a temporary pull request branch with name tmpstagingv$VERSION"'
				sh 'git push --set-uprstream tmpstagingv$VERSION '
				sh 'gh --version'					
				sh 'echo \$GH_TOKENCRED_PSW|gh auth login --hostname github.com --with-token'
				sh 'gh auth status'
				sh 'gh pr create --title "Staging branch v$VERSION was successful" --body "Staging branch version$VERSION was successfully tested and deployed needs to be merged into production" --base production --head tmpstagingv$VERSION'
				sh 'gh auth logout --hostname github.com'

				/*withCredentials([usernamePassword(credentialsId: '755f872e-4fbe-4127-93cd-8d917ac48242', passwordVariable: 'GH_TOKEN', usernameVariable: 'GH_USERNAME')]) {					
					script {
						sh 'gh --version'
						sh 'export GITHUB_TOKEN='
						sh "git config --global credential.https://github.com.helper ''"
						sh "git config --global 'credential.https://github.com' '!gh auth git-credential' "
						sh 'echo \$GH_TOKEN|gh auth login --with-token'
						sh 'gh auth status'
						sh 'gh pr create'
						//sh 'gh pr create --title "Staging branch successful" --body "Staging branch version1.0 needs to be merged into production" --base production'
						sh 'gh auth logout'
					}
					
				}*/

				/*sshagent(['e833b0c8-199a-4d54-a272-a021d20c622b']) {
					script {
						sh 'gh --version'					
						sh 'echo \$GH_TOKENCRED_PSW|gh auth login --hostname github.com --with-token'
						sh 'gh auth status'
						sh 'gh pr create --title "Staging branch successful" --body "Staging branch version1.0 needs to be merged into production" --base production'
						sh 'gh auth logout'
					}
				}*/
				
				
			}
		}
	}

