def stagedFiles = 0
def productionFiles = 0
def masterFiles = 0

pipeline {
    // Configure fork pull requests to use the trusted target-branch Jenkinsfile.
    // The public-ci label must point to an isolated worker with no deployment access.
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        skipStagesAfterUnstable()
    }

    environment {
        VERSION = "3.0.${BUILD_NUMBER}"
        BASE_DIRECTORY = 'paulgobero_com'
        REMOTE_USER = 'deployuser1'
        REMOTE_DIR = 'STAGE_PORTFOLIO'
        REMOTE_FOLDER = 'paulgobero_com'
        STACKNAME = 'stagingportfolio'
        GIT_REPO = 'git@github.com:Paul-GL721/portfolio.git'
        EMAIL_TO = 'portfolioteam@paulgobero.com'
    }

    stages {
        stage('1. Verify public pull request') {
            when {
                changeRequest()
            }
            agent {
                label 'buildnode'
            }
            steps {
                dir(env.BASE_DIRECTORY) {
                    sh 'npm ci'
                    sh '''
                        set -eu
                        if [ "${CHANGE_TARGET:-}" = "development" ]; then
                            test -f __tests__/service.test.js
                            test -f __tests__/caseStudy.test.js
                            npm run test:portfolio-content
                        elif [ -f __tests__/service.test.js ] && [ -f __tests__/caseStudy.test.js ]; then
                            npm run test:portfolio-content
                        else
                            echo "Focused content tests are not packaged on the ${CHANGE_TARGET:-release} branch."
                        fi
                    '''
                    sh 'node --check app.js'
                    sh 'find controllers models routes utils -type f -name "*.js" -print0 | xargs -0 -n1 node --check'
                }
                sh 'git diff --check'
            }
            post {
                always {
                    deleteDir()
                }
            }
        }

        stage('2. Test development') {
            when {
                allOf {
                    branch 'development'
                    not {
                        changeRequest()
                    }
                }
            }
            agent {
                label 'buildnode'
            }
            environment {
                ENV_FILE_PATH = '/glustervol/portfolio/paulgobero/configs/.env.test'
            }
            steps {
                sh 'bash ./${BASE_DIRECTORY}/jenkins-scripts/test-step.sh'
            }
            post {
                always {
                    archiveArtifacts artifacts: "${env.BASE_DIRECTORY}/coverage/**/*", allowEmptyArchive: true
                }
            }
        }

        stage('3. Promote development to staging') {
            when {
                allOf {
                    branch 'development'
                    not {
                        changeRequest()
                    }
                }
            }
            agent {
                label 'buildnode'
            }
            steps {
                sshagent(credentials: ['e833b0c8-199a-4d54-a272-a021d20c622b']) {
                    script {
                        sh 'bash ./${BASE_DIRECTORY}/jenkins-scripts/promote-code-step.sh development staging ci/promote-development-${VERSION}'
                        stagedFiles = sh(
                            script: 'git diff --cached --numstat | wc -l',
                            returnStdout: true
                        ).trim().toInteger()

                        if (stagedFiles > 0) {
                            sh 'git commit -m "chore(staging): promote development ${VERSION}"'
                            sh 'git push ${GIT_REPO} HEAD:staging'
                        } else {
                            echo 'Staging already contains the current development application code.'
                        }
                    }
                }
            }
        }

        stage('4. Build staging image') {
            when {
                allOf {
                    branch 'staging'
                    not {
                        changeRequest()
                    }
                }
            }
            agent {
                label 'buildnode'
            }
            steps {
                echo "Building staging image paulgl721/nodejs-portfolio:stagingV${env.VERSION}"
                sh 'bash ./${BASE_DIRECTORY}/jenkins-scripts/build-step.sh ${VERSION}'
            }
        }

        stage('5. Deploy staging') {
            when {
                allOf {
                    branch 'staging'
                    not {
                        changeRequest()
                    }
                }
            }
            agent {
                label 'deploynode'
            }
            steps {
                sh """ansible-playbook ./${env.BASE_DIRECTORY}/ansible/portfolio-playbook.yml \\
                    -i ./${env.BASE_DIRECTORY}/ansible/inventory.ini \\
                    --extra-vars=\"{'REMOTE_USER': '${env.REMOTE_USER}', 'GIT_REPO': '${env.GIT_REPO}', 'REMOTE_DIR': '${env.REMOTE_DIR}', 'REMOTE_FOLDER': '${env.REMOTE_FOLDER}', 'STACKNAME': '${env.STACKNAME}', 'VERSION': '${env.VERSION}'}\" \\
                    -v"""
            }
        }

        stage('6. Verify staging deployment') {
            when {
                allOf {
                    branch 'staging'
                    not {
                        changeRequest()
                    }
                }
            }
            agent {
                label 'deploynode'
            }
            steps {
                retry(6) {
                    sleep time: 10, unit: 'SECONDS'
                    sh 'curl --fail --silent --show-error --max-time 15 https://stagingwww.paulgobero.com/portfolio/readiness > /dev/null'
                }
            }
        }

        stage('7. Approve production promotion') {
            when {
                allOf {
                    branch 'staging'
                    not {
                        changeRequest()
                    }
                }
            }
            input {
                message 'Staging is healthy. Promote this release to production?'
                ok 'Promote'
            }
            steps {
                echo "Production promotion approved for ${env.VERSION}."
            }
        }

        stage('8. Promote staging to production') {
            when {
                allOf {
                    branch 'staging'
                    not {
                        changeRequest()
                    }
                }
            }
            agent {
                label 'buildnode'
            }
            steps {
                sshagent(credentials: ['e833b0c8-199a-4d54-a272-a021d20c622b']) {
                    script {
                        sh 'bash ./${BASE_DIRECTORY}/jenkins-scripts/promote-code-step.sh staging production ci/promote-staging-${VERSION}'
                        productionFiles = sh(
                            script: 'git diff --cached --numstat | wc -l',
                            returnStdout: true
                        ).trim().toInteger()

                        if (productionFiles > 0) {
                            sh 'git commit -m "chore(production): promote staging ${VERSION}"'
                            sh 'git push ${GIT_REPO} HEAD:production'
                        } else {
                            echo 'Production already contains the current staging application code.'
                        }
                    }
                }
            }
        }

        stage('9. Prepare master pull request') {
            when {
                allOf {
                    branch 'production'
                    not {
                        changeRequest()
                    }
                }
            }
            agent {
                label 'buildnode'
            }
            steps {
                sshagent(credentials: ['e833b0c8-199a-4d54-a272-a021d20c622b']) {
                    script {
                        sh 'bash ./${BASE_DIRECTORY}/jenkins-scripts/promote-code-step.sh production master tmpproductionV${VERSION}'
                        masterFiles = sh(
                            script: 'git diff --cached --numstat | wc -l',
                            returnStdout: true
                        ).trim().toInteger()

                        if (masterFiles > 0) {
                            sh 'git commit -m "chore(release): prepare production ${VERSION}"'
                            sh 'git push --force-with-lease ${GIT_REPO} HEAD:tmpproductionV${VERSION}'
                            env.CREATE_MASTER_PR = 'true'
                        } else {
                            echo 'Master already contains the current production application code.'
                            env.CREATE_MASTER_PR = 'false'
                        }
                    }
                }
            }
        }

        stage('10. Create master pull request') {
            when {
                allOf {
                    branch 'production'
                    expression {
                        env.CREATE_MASTER_PR == 'true'
                    }
                }
            }
            agent {
                label 'buildnode'
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'jenkins-post-pr-portfolio',
                    usernameVariable: 'GH_USERNAME',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        gh --version
                        if gh pr list --base master --head "tmpproductionV${VERSION}" --state open --json number --jq 'length' | grep -q '^0$'; then
                            gh pr create \\
                                --title "Production release ${VERSION}" \\
                                --body "Staging release ${VERSION} passed deployment verification and is ready to merge into master." \\
                                --base master \\
                                --head "tmpproductionV${VERSION}"
                        else
                            echo "An open pull request already exists for tmpproductionV${VERSION}."
                        fi
                    '''
                }
            }
        }

        stage('11. Build production image') {
            when {
                allOf {
                    branch 'master'
                    not {
                        changeRequest()
                    }
                }
            }
            agent {
                label 'buildnode'
            }
            environment {
                REMOTE_DIR = 'PORTFOLIO'
                STACKNAME = 'portfolio'
            }
            steps {
                echo "Building production image paulgl721/nodejs-portfolio:prodappV${env.VERSION}"
                sh 'bash ./${BASE_DIRECTORY}/jenkins-scripts/build-step.sh ${VERSION}'
            }
        }

        stage('12. Deploy production') {
            when {
                allOf {
                    branch 'master'
                    not {
                        changeRequest()
                    }
                }
            }
            agent {
                label 'deploynode'
            }
            environment {
                REMOTE_DIR = 'PORTFOLIO'
                STACKNAME = 'portfolio'
            }
            steps {
                sh """ansible-playbook ./${env.BASE_DIRECTORY}/ansible/portfolio-playbook.yml \\
                    -i ./${env.BASE_DIRECTORY}/ansible/inventory.ini \\
                    --extra-vars=\"{'REMOTE_USER': '${env.REMOTE_USER}', 'GIT_REPO': '${env.GIT_REPO}', 'REMOTE_DIR': '${env.REMOTE_DIR}', 'REMOTE_FOLDER': '${env.REMOTE_FOLDER}', 'STACKNAME': '${env.STACKNAME}', 'VERSION': '${env.VERSION}'}\" \\
                    -v"""
            }
        }

        stage('13. Verify production deployment') {
            when {
                allOf {
                    branch 'master'
                    not {
                        changeRequest()
                    }
                }
            }
            agent {
                label 'deploynode'
            }
            steps {
                retry(6) {
                    sleep time: 10, unit: 'SECONDS'
                    sh 'curl --fail --silent --show-error --max-time 15 https://www.paulgobero.com/portfolio/readiness > /dev/null'
                }
            }
        }
    }

    post {
        success {
            echo 'Job executed successfully.'
            emailext(
                body: 'The pipeline completed successfully. Check $BUILD_URL for details.',
                subject: 'Successful portfolio pipeline: $PROJECT_NAME - #$BUILD_NUMBER',
                to: env.EMAIL_TO
            )
        }
        failure {
            echo 'Job failed.'
            emailext(
                body: 'The pipeline failed. Check $BUILD_URL for details.\n\n${CHANGES}\n\n${BUILD_LOG, maxLines=100, escapeHtml=false}',
                subject: 'Failed portfolio pipeline: $PROJECT_NAME - #$BUILD_NUMBER',
                to: env.EMAIL_TO
            )
        }
    }
}
