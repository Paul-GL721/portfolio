
{% extends "website_base.njk" %}

{% block title %}<title>{{ Title }}</title> {% endblock %}

{% block content %}
    <section style="padding-top: 80px;">
        <div class="row">
            <div class="col-md-1"></div>
            <div class="col-sm-12 col-md-10">
                <h3 style="text-align: center;">Skills Admin Form</h3>
                <div class="table-responsive">
                    <table class="table table-striped" data-toggle="table" data-pagination="true" data-show-refresh="true" data-id-field="true" data-maintain-selected="true" data-toolbar="#toolbar" data-search="true" data-smart-display="true">
                        <thead>
                            <tr>
                                <th data-checkbox="true" data-field="state"></th>
                                <th id="skills_id" data-field="skilid">id</th>
                                <th id="cellicon" data-field="imageUrl">Icon</th>
                                <th id="cellskillname" data-field="imageName">Skill Name</th>
                                <th id="cellskilldesc" data-field="Description">Skill Description</th>
                                <th id="cellactions" data-field="Actions" style="width: 30%;min-width: 10px;max-width: 30px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for skill in abtskills %}
                            <tr>
                                <td></td>
                                <td>{{ skill._id }}</td>
                                <td><img class="rounded-circle img-fluid" src="{{ skill.imageUrl }}" width="40" height="40"></td>
                                <td>{{ skill.name }}</td>
                                <td>{{ skill.description }}</td>
                                <td><a title="Edit Row"><i class="icon-pencil tableicons" style="padding-left: 25px;padding-right: 0px;"></i></a></td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-1"></div>
        </div>
    </section>
{% endblock %}


