
<form id="Skillsform" name="Skillsform" action="{{ posturl }}" method="post" enctype="multipart/form-data">
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="skillname"><strong>Skill Name:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><input class="form-control" type="text" id="skillname" name="skillname" placeholder="Enter Skill Name"></div>
    </div>
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="skilldescription"><strong>Skill Description:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><textarea class="form-control" id="skilldescription" name="skilldescription" placeholder="Describe skill" rows="5" cols="10"></textarea></div>
    </div>
    <div class="form-group row">
        <div class="col-5 col-sm-3 col-md-4 col-lg-4 offset-1 offset-sm-3 offset-md-2 offset-lg-3"><label class="col-form-label" for="photo1"><strong>Skill Icon:</strong></label></div>
        <div class="col-6 col-sm-6 col-md-6 col-lg-5 text-sm-center"><input class="form-control-file imgz" type="file" id="photo1" set-to="div1" name="photo1"><img class="img-fluid image" id="div1" src="#" alt="Display Front image"></div>
    </div>
    
