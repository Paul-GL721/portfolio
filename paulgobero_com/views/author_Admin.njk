
{% extends "website_base.njk" %}
{% set posturl = {submiturl: "author/update" } %}
{% set navbarurl = {about: "/#about_section", projects: "/#project_section", contact: "/#contact_section" } %}

{% block title %}<title>{{ Title }}</title> {% endblock %}

{% block content %}
	<section class="formsection">
        <div class="row">
            <div class="col-sm-12 col-md-12">
                <h3 style="text-align: center;">Author's Admin Table</h3>
                <div id="toolbar"><button class="btn btn-secondary mr-3" id="authorbtnAdd" type="button" title="Add New Author" onclick="location.href='author/create'"><i class="icon-plus tableicons"></i>Add</button><button class="btn btn-danger" id="authorbtnDelete" type="button" title="Delete Selected  Author(s)"><i class="icon-trash tableicons"></i>Delete</button></div>
                <div class="table-responsive">
                    <table class="table table-striped" id="authortable" data-toggle="table" data-pagination="true" data-show-refresh="true" data-id-field="true" data-maintain-selected="true" data-toolbar="#toolbar" data-search="true" data-smart-display="true" data-maintain-meta-data="true">
                        <thead>
                            <tr>
                                <th data-checkbox="true" data-field="state"></th>
                                <th id="author_id" data-field="authoridz">id</th>
                                <th id="cellprofilepic" data-field="imageUrl">Profile Picture</th>
                                <th id="cellauthorfirstname" data-field="namefirst">First Name</th>
                                <th id="cellauthormiddlename" data-field="namemiddle">Middle Name</th>
                                <th id="cellauthorlastname" data-field="namelast">Last Name</th>
                                <th id="cellauthorshortdesc" data-field="shortdesc">Short Description</th>
                                <th id="cellauthorlongdesc" data-field="longdesc">Long Description</th>
                                <th id="cellauthoremail" data-field="authoremail">Email</th>
                                <th id="cellauthorStaus" data-field="authorStaus">Status</th>
                                <th id="cellauthorRole" data-field="authorRole">Role</th>
                                <th id="cellgithuburl" data-field="githuburl">Github</th>
                                <th id="celllinkeninurl" data-field="linkeninurl">LinkedIn</th>
                                <th id="cellactions" data-field="Actions" style="width: 30%;min-width: 10px;max-width: 30px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
	                        {% for author in abtauthor %}
	                            <tr>
	                                <td></td>
	                                <td>{{ author._id }}</td>
	                                <td><img class="rounded-circle img-fluid" src="{{ author.imageUrl }}" width="40" height="40"></td>
	                                <td>{{ author.name.first }}</td>
	                                <td>{{ author.name.middle }}</td>
	                                <td>{{ author.name.last }}</td>
                                    <td>{{ author.about.short_description }}</td>
                                    <td>{{ author.about.full_description }}</td>
	                                <td>{{ author.brandName }}</td>
	                                <td>{{ author.email }}</td>
                                    <td>{{ author.authorStatus }}</td>
                                    <td>{{ author.authorRole }}</td>
	                                <td>{{ author.socialmedia.github | urlize | safe }}</td>
	                                <td>{{ author.socialmedia.linkedin | urlize | safe }}</td>
	                                <td><a title="Edit Row"><i class="icon-pencil tableicons authoredit" style="padding-left: 25px;padding-right: 0px;"></i></a></td>
	                            </tr>
	                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="col">
                    <div class="modal fade" role="dialog" tabindex="-1" id="authorUpdateModal">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h4 class="modal-title">Update Author Details</h4><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                                </div>
                                <div class="modal-body">
                                    <div class="container-fluid">
                                        {% include "reuse_author.njk" %}
                                        <div class="form-group row">
                                            <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="authorUpdateid"><strong>Author Update ID:</strong></label></div>
                                            <div class="col-7 col-sm-7 col-md-8"><input class="form-control" type="text" id="authorUpdateid" name="authorUpdateid" readonly="" placeholder="Author Update Id"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer"><button class="btn btn-light" type="button" data-dismiss="modal">Close</button><button id="authorUpdatebtn" class="btn btn-primary" type="submit">Save changes</button></div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
