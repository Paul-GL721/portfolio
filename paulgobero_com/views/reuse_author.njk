

<form id="{{ posturl.formid }}" name="Authorform" enctype="multipart/form-data" >
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="authorfirstname"><strong>First Name:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><input class="form-control" type="text" id="authorfirstname" name="authorfirstname" placeholder="Enter First Name" required=""></div>
    </div>
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="authormiddlename"><strong>Middle Name:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><input class="form-control" type="text" id="authormiddlename" name="authormiddlename" placeholder="Enter Middle Name"></div>
    </div>
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="authorlastname"><strong>Last Name:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><input class="form-control" type="text" id="authorlastname" name="authorlastname" placeholder="Enter Last Name" required=""></div>
    </div>
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="authorbrandname"><strong>Brand Name:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><input class="form-control" type="text" id="authorbrandname" name="authorbrandname" placeholder="Enter Prefered Brand Name"></div>
    </div>
    <div class="form-group row">
        <div class="col-5 col-sm-3 col-md-4 col-lg-4 offset-1 offset-sm-3 offset-md-2 offset-lg-3"><label class="col-form-label" for="photo1"><strong>Profile Image:</strong></label></div>
        <div class="col-6 col-sm-6 col-md-6 col-lg-5 text-sm-center"><input class="form-control-file imgz" type="file" id="photo1" set-to="div1" name="photo1"><img class="img-fluid image" id="div1" src="#" alt="Display Front image"></div>
    </div>
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="authorshortdesc"><strong>Job Title:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><input class="form-control" type="text" id="authorshortdesc" name="authorshortdesc" placeholder="Short description of You" required=""></div>
    </div>
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="authorfulldesc"><strong>Full Description:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><textarea class="form-control" id="authorfulldesc" name="authorfulldesc" placeholder="More about you" rows="3" cols="10" required=""></textarea></div>
    </div>
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="authoremail"><strong>Email:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><input class="form-control" type="email" id="authoremail" name="authoremail" placeholder="Enter Email Address" required=""></div>
    </div>
    <div class="form-row">
        <div class="col text-center">
            <h4>Social Accounts</h4>
        </div>
    </div>
    <div>
        <div class="form-row">
            <div class="col-12 col-sm-12 col-md-6" style="text-align: center;"><label class="col-form-label" style="text-align: center;"><input class="form-control" type="url" id="githuburl" name="githuburl" placeholder="Github link"></label></div>
            <div class="col-12 col-sm-12 col-md-6" style="text-align: center;"><label class="col-form-label" style="text-align: center;"><input class="form-control" type="url" id="linkeninurl" name="linkeninurl" placeholder="Linkendin link"></label></div>
        </div>
    </div>



