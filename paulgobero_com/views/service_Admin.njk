{% extends "portfolio_base.njk" %}
{% set navbarurl = {about: "/portfolio/#about_section", services: "/portfolio/#services-section", projects: "/portfolio/#project_section", skills: "/portfolio/#skill_section", contact: "/portfolio/#contact_section"} %}
{% set posturl = {submiturl: "/portfolio/service/update"} %}

{% block title %}<title>{{ Title }}</title>{% endblock %}
{% block content %}
<main class="formsection admin-service-page">
    <div class="container-fluid py-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div><h1 class="h2 mb-1">Services</h1><p class="text-muted mb-0">Control what the portfolio owner offers and how it appears.</p></div>
            <a class="btn btn-primary" href="/portfolio/service/create">Add service</a>
        </div>
        <section class="card mb-5" aria-labelledby="service-section-content-title">
            <div class="card-body">
                <h2 class="h4" id="service-section-content-title">Section introduction</h2>
                <p class="text-muted">This content appears above the service cards on the public homepage.</p>
                <form action="/portfolio/service/section" method="post">
                    <div class="form-group">
                        <label for="serviceeyebrow"><strong>Section label</strong></label>
                        <input class="form-control" id="serviceeyebrow" name="serviceeyebrow" maxlength="60" value="{{ section.eyebrow or 'Services' }}" required>
                    </div>
                    <div class="form-group">
                        <label for="serviceheading"><strong>Heading</strong></label>
                        <input class="form-control" id="serviceheading" name="serviceheading" maxlength="120" value="{{ section.heading or 'How I Can Help' }}" required>
                    </div>
                    <div class="form-group">
                        <label for="serviceintroduction"><strong>Introduction</strong></label>
                        <textarea class="form-control" id="serviceintroduction" name="serviceintroduction" rows="4" maxlength="700" required>{{ section.introduction or 'I work across product delivery, systems integration, cloud deployment, and automation so teams can move from messy workflows to reliable digital operations.' }}</textarea>
                    </div>
                    <button class="btn btn-primary" type="submit">Save section introduction</button>
                </form>
            </div>
        </section>
        <div class="table-responsive">
            <table class="table table-striped service-admin-table">
                <thead><tr><th>Order</th><th>Service</th><th>Description</th><th>Tags</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                {% for service in services %}
                    <tr data-service-id="{{ service._id }}">
                        <td>{{ service.displayOrder }}</td>
                        <td><i class="{{ service.icon }}" aria-hidden="true"></i> {{ service.title }}</td>
                        <td>{{ service.description }}</td>
                        <td>{{ service.tags | join(", ") }}</td>
                        <td>{% if service.published %}<span class="badge badge-success">Published</span>{% else %}<span class="badge badge-secondary">Draft</span>{% endif %}</td>
                        <td class="service-actions">
                            <button class="btn btn-sm btn-outline-primary service-edit" type="button">Edit</button>
                            <button class="btn btn-sm btn-outline-danger service-delete" type="button">Delete</button>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center py-4">No services yet. The homepage will continue using its legacy service content until you add and publish one.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="serviceUpdateModal" tabindex="-1" role="dialog" aria-labelledby="serviceUpdateTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document"><div class="modal-content"><form id="serviceForm" action="{{ posturl.submiturl }}" method="post">
            <div class="modal-header"><h2 class="modal-title h4" id="serviceUpdateTitle">Edit service</h2><button class="close" type="button" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div>
            <div class="modal-body">
                {% set service = {} %}{% include "reuse_service.njk" %}
                <input type="hidden" id="serviceUpdateid" name="serviceUpdateid">
            </div>
            <div class="modal-footer"><button class="btn btn-light" type="button" data-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Save changes</button></div>
        </form></div></div>
    </div>
</main>
{% endblock %}
