

<form id="{{ posturl.formid }}" name="specform" action="{{ posturl.submiturl }}" method="post" >
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="specialisationname"><strong>Specializations:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><input class="form-control" type="text" id="specialisationname" name="specialisationname" placeholder="Enter Specialisation Name"></div>
    </div>
    <div class="form-group row">
        <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="specialisationdescription"><strong>Description:</strong></label></div>
        <div class="col-7 col-sm-7 col-md-8"><textarea class="form-control" id="specialisationdescription" name="specialisationdescription" placeholder="Describe the Specialisation" rows="5" cols="10"></textarea></div>
    </div>
    