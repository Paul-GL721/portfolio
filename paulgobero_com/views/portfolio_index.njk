{% extends "portfolio_base.njk" %}
{% set navbarurl = {id: "indexpage", about: "#about_section", services: "#services-section", projects: "#project_section", skills: "#skill_section", contact: "#contact_section", blog: "https://blog.paulgobero.com" } %}

{% block createDemoUserbutton %}
{% endblock %}

{% block content %}
    <main class="portfolio-home">
        <section id="about_section" class="portfolio-hero">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-7 hero-copy">
                        <p class="eyebrow">Full-stack engineering and DevOps</p>
                        <h1>{{ index_data.author.about.short_description | title }}</h1>
                        <p class="hero-lead">{{ index_data.author.about.full_description }}</p>
                        <div class="hero-actions">
                            <a class="btn btn-primary btn-lg" href="#project_section">View Work</a>
                            <a class="btn btn-outline-dark btn-lg" href="#contact_section">Start a Project</a>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="hero-portrait-wrap">
                            <img class="hero-portrait" src="{{ index_data.author.imageUrl }}" alt="{{ meta_author or brand1.brandName or 'Portfolio owner' }}">
                            <div class="hero-snapshot">
                                <span>Building useful software</span>
                                <strong>From idea to stable release</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="services-section" class="home-section services-section">
            <div class="container">
                <div class="section-heading">
                    <p class="eyebrow">Services</p>
                    <h2>How I Can Help</h2>
                    <p>I work across product delivery, systems integration, cloud deployment, and automation so teams can move from messy workflows to reliable digital operations.</p>
                </div>

                <div class="service-list">
                    {% if index_data.services and index_data.services.length %}
                        {% for service in index_data.services %}
                            <article class="service-row">
                                <span class="service-number">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
                                <div class="service-icon" aria-hidden="true"><i class="{{ service.icon or 'icon-layers' }}"></i></div>
                                <div class="service-copy">
                                    <h3>{{ service.title }}</h3>
                                    <p>{{ service.description }}</p>
                                    {% if service.tags and service.tags.length %}
                                        <div class="service-tags">
                                            {% for tag in service.tags %}<span>{{ tag }}</span>{% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </article>
                        {% endfor %}
                    {% else %}
                    <article class="service-row">
                        <span class="service-number">01</span>
                        <div class="service-icon">
                            <i class="icon-layers"></i>
                        </div>
                        <div class="service-copy">
                            <h3>Digital Transformation</h3>
                            <p>Convert manual and disconnected operations into reliable digital workflows with clearer data, better visibility, and faster decisions.</p>
                            <div class="service-tags">
                                <span>Workflow automation</span>
                                <span>Dashboards</span>
                                <span>Data capture</span>
                            </div>
                        </div>
                    </article>

                    <article class="service-row">
                        <span class="service-number">02</span>
                        <div class="service-icon">
                            <i class="icon-screen-desktop"></i>
                        </div>
                        <div class="service-copy">
                            <h3>Custom Software & Integration</h3>
                            <p>Build web and mobile applications around business needs, then connect them with ERP, CRM, POS, cloud, and internal systems.</p>
                            <div class="service-tags">
                                <span>Web apps</span>
                                <span>APIs</span>
                                <span>System integration</span>
                            </div>
                        </div>
                    </article>

                    <article class="service-row">
                        <span class="service-number">03</span>
                        <div class="service-icon">
                            <i class="icon-cloud-upload"></i>
                        </div>
                        <div class="service-copy">
                            <h3>Cloud Deployment</h3>
                            <p>Move applications onto secure, scalable infrastructure designed for availability, performance, maintainability, and growth.</p>
                            <div class="service-tags">
                                <span>AWS</span>
                                <span>Containers</span>
                                <span>Monitoring</span>
                            </div>
                        </div>
                    </article>

                    <article class="service-row">
                        <span class="service-number">04</span>
                        <div class="service-icon">
                            <i class="icon-refresh"></i>
                        </div>
                        <div class="service-copy">
                            <h3>DevOps Automation</h3>
                            <p>Automate deployments, monitoring, and infrastructure tasks so releases become faster, safer, and easier to repeat.</p>
                            <div class="service-tags">
                                <span>CI/CD</span>
                                <span>Infrastructure automation</span>
                                <span>Observability</span>
                            </div>
                        </div>
                    </article>
                    {% endif %}
                </div>
            </div>
        </section>

        <section id="project_section" class="home-section projects-section">
            <div class="container">
                <div class="section-heading section-heading-split">
                    <div>
                        <p class="eyebrow">Selected Work</p>
                        <h2>Recent Projects</h2>
                    </div>
                    <p>
                        A few examples of recent builds.
                        <a href="#allprojectmodal" data-toggle="modal">View all projects</a>
                    </p>
                </div>

                <div class="row">
                    {% for dindex in index_data.author_projects %}
                        {% if loop.index <= 3 %}
                            <div class="col-md-6 col-lg-4 mb-4">
                                <article class="project-card">
                                    <img src="{{ dindex.mediaUrl.imageUrl }}" alt="{{ dindex.ptitle }}">
                                    <div class="project-card-body">
                                        <h3>{{ dindex.ptitle }}</h3>
                                        <p>{{ dindex.psummary | truncate(190, true, '...') }}</p>
                                        {% set project = dindex %}
                                        {% include "reuse_project_metrics.njk" %}
                                        <div class="project-skill-list">
                                            {% for skll in dindex.skill %}
                                                {% if loop.index <= 3 %}
                                                    <span>{{ skll.name }}</span>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                        {% if dindex.slug and dindex.status == "published" %}
                                            <a href="{{ dindex.url }}" class="project-card-link">Read Case Study</a>
                                        {% else %}
                                            <a href="#" class="project-modal-link project-card-link" data-project-id="{{ dindex._id }}">Read Case Study</a>
                                        {% endif %}
                                    </div>
                                </article>

                                <div class="modal fade" id="projectmodal-{{ dindex._id }}" tabindex="-1" aria-labelledby="projectModalLabel-{{ dindex._id }}" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
                                        <div class="modal-content shadow-lg border-0 rounded-3">
                                            <div class="modal-header border-0 pb-0">
                                                <h3 class="modal-title fw-bold text-primary" id="projectModalLabel-{{ dindex._id }}">
                                                    {{ dindex.ptitle }}
                                                </h3>
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">x</span></button>
                                            </div>

                                            <div class="modal-body">
                                                <section class="showcase">
                                                    <div class="container-fluid p-0">
                                                        <div class="mb-4">
                                                            <h5 class="fw-semibold text-secondary">Challenge</h5>
                                                            <p class="fs-6 text-dark">{{ dindex.problemStatement }}</p>
                                                        </div>

                                                        <div class="mb-4">
                                                            <h5 class="fw-semibold text-secondary">Solution</h5>
                                                            <p class="fs-6 text-dark">{{ dindex.solution }}</p>
                                                        </div>

                                                        {% if dindex.mediaUrl.videoUrl %}
                                                            <div class="text-center my-4">
                                                                <video class="border rounded shadow-sm w-100" controls src="{{ dindex.mediaUrl.videoUrl }}"></video>
                                                            </div>
                                                        {% endif %}

                                                        <div class="mb-4">
                                                            <h5 class="fw-semibold text-secondary">My Role</h5>
                                                            <ul class="fs-6 text-left text-dark">
                                                                {% for item in dindex.role.split('\n') %}
                                                                    {% if item.trim() %}
                                                                        <li>{{ item.trim() }}</li>
                                                                    {% endif %}
                                                                {% endfor %}
                                                            </ul>
                                                        </div>

                                                        <div class="mb-4">
                                                            <h5 class="fw-semibold text-secondary">Skills Applied</h5>
                                                            <p class="fs-6 text-dark">
                                                                {% for skll in dindex.skill %}
                                                                    <span class="skill-pill">{{ skll.name }}</span>
                                                                {% endfor %}
                                                            </p>
                                                        </div>

                                                        {% if dindex.githubUrl or dindex.livelinkUrl %}
                                                            <div class="mb-3">
                                                                <h5 class="fw-semibold text-secondary">Project Links</h5>
                                                                <p class="fs-6 text-dark project-modal-links">
                                                                    {% if dindex.githubUrl %}
                                                                        <a href="{{ dindex.githubUrl }}" class="text-primary fw-semibold" target="_blank" rel="noopener noreferrer">View on GitHub</a>
                                                                    {% endif %}
                                                                    {% if dindex.livelinkUrl %}
                                                                        <a href="{{ dindex.livelinkUrl }}" class="text-primary fw-semibold" target="_blank" rel="noopener noreferrer">Live Demo</a>
                                                                    {% endif %}
                                                                </p>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                </section>
                                            </div>

                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <div class="modal fade" id="allprojectmodal" tabindex="-1" role="dialog" aria-labelledby="allProjectsLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" role="document">
                        <div class="modal-content shadow-lg border-0 rounded-3">
                            <div class="modal-header border-0 pb-0">
                                <h3 class="modal-title fw-bold text-primary w-100 text-center" id="allProjectsLabel">All Projects</h3>
                                <button type="button" class="close position-absolute" style="top: 0.5rem; right: 1rem; z-index: 10;" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>

                            <div class="modal-body px-4">
                                <ul class="list-group list-group-flush all-project-list">
                                    {% for proj in index_data.author_all_projects %}
                                        <li class="list-group-item px-0 py-3">
                                            <h5 class="fw-semibold mb-1">
                                                <a href="{{ proj.url }}" class="text-primary text-decoration-none" target="_blank">{{ proj.ptitle | capitalize | urlize | safe }}</a>
                                            </h5>
                                            <p class="text-muted mb-0">{{ proj.psummary | capitalize | urlize | safe }}</p>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>

                            <div class="modal-footer border-0 pt-0 justify-content-end pe-4">
                                <button class="btn btn-outline-secondary px-4" type="button" data-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="skill_section" class="home-section skills-section">
            <div class="container">
                <div class="section-heading">
                    <p class="eyebrow">Toolbox</p>
                    <h2>Skills I Use to Ship</h2>
                    <p>A practical stack for building applications, integrations, infrastructure, and reliable delivery workflows.</p>
                </div>

                <div class="skills-grid">
                    {% set unique_skills = [] %}
                    {% for pindex in index_data.author_projects %}
                        {% for sindex in pindex.skill %}
                            {% if sindex.name not in unique_skills %}
                                {% set unique_skills = unique_skills + [sindex.name] %}
                                <div class="skill-card">
                                    <img src="{{ sindex.imageUrl }}" alt="{{ sindex.name }}">
                                    <span>{{ sindex.name }}</span>
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
        </section>

        <section id="contact_section" class="home-section contact-section">
            <div class="container">
                <div class="row align-items-start">
                    <div class="col-lg-5 mb-4 mb-lg-0">
                        <p class="eyebrow">Contact</p>
                        <h2>Let us build something useful together.</h2>
                        <p class="contact-copy">
                            Whether you are hiring or planning a system, share the opportunity, workflow, integration, or product you are thinking about.
                        </p>
                        <div class="contact-paths">
                            <article class="contact-note">
                                <strong>Hiring for a technical role?</strong>
                                <span>Share the role, team, location and the problems the person will help solve.</span>
                            </article>
                            <article class="contact-note">
                                <strong>Need an operational system?</strong>
                                <span>Describe the manual workflow, disconnected data or product challenge you want to improve.</span>
                            </article>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div id="contact_form_div" class="contact-form-shell">
                            {% include "partial_contact_form.njk" %}
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
