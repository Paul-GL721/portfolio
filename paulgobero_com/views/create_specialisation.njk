
{% set Title = "Portfolio Create Specialisation" %}
{% extends "website_base.njk" %}

{% block title %}<title>{{ Title }}</title> {% endblock %}

{% block content %}
	<div class="row">
        <div class="col-md-2"></div>
        <div class="col-12 col-sm-12 col-md-8" id="main_div">
            <div class="page-header">
                <h1 class="text-center projheading"><em><span style="text-decoration: underline;">About the Specialisation</span></em></h1>
            </div>
            <form id="Specialisationform" name="Specialisationform" action="http://localhost/glsranchers/Database1/Backend/Entryinfo/entrysubmtvals.php" method="post" enctype="multipart/form-data">
                <div class="form-group row">
                    <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="specialisationname"><strong>Specialization:</strong></label></div>
                    <div class="col-7 col-sm-7 col-md-8"><input class="form-control" type="text" id="specialisationname" name="specialisationname" placeholder="Enter Specialisation Name" value="undefined===spec ? ' ' : spec.specialisationname"></div>
                </div>
                <div class="form-group row">
                    <div class="col-5 col-sm-5 col-md-4"><label class="col-form-label" for="specialisationdescription"><strong>Description:</strong></label></div>
                    <div class="col-7 col-sm-7 col-md-8"><textarea class="form-control" id="specialisationdescription" name="specialisationdescription" placeholder="Describe the Specialisation" rows="5" cols="10"></textarea></div>
                </div>
                <div class="form-group row">
                    <div class="col-8 col-sm-8 col-md-8 col-lg-8 offset-4"><button class="btn btn-success text-center" id="specialisationsubmitbutton" name="specialisationsubmitbutton" type="submit">Submit</button></div>
                </div>
            </form>
            <div class="form-group row">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12 success" id="response"></div>
            </div>
        </div>
        <div class="col-md-2"></div>
    </div>
{% endblock %}


