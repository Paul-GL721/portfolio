{% extends "portfolio_base.njk" %}
{% set navbarurl = {about: "/portfolio/#about_section", services: "/portfolio/#services-section", projects: "/portfolio/#project_section", skills: "/portfolio/#skill_section", contact: "/portfolio/#contact_section"} %}
{% set posturl = {submiturl: "/portfolio/service/create"} %}

{% block title %}<title>{{ Title }}</title>{% endblock %}
{% block content %}
<main class="formsection admin-service-page">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h2 mb-0">Add a service</h1>
                    <a href="/portfolio/service">Manage services</a>
                </div>
                {% if errors %}
                    <div class="alert alert-danger" role="alert"><ul class="mb-0">{% for error in errors %}<li>{{ error.msg }}</li>{% endfor %}</ul></div>
                {% endif %}
                <div class="card"><div class="card-body">
                    <form id="serviceForm" action="{{ posturl.submiturl }}" method="post">
                    {% include "reuse_service.njk" %}
                    <button class="btn btn-primary" type="submit">Save service</button>
                    </form>
                </div></div>
            </div>
        </div>
    </div>
</main>
{% endblock %}
