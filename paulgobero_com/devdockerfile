#1. From the nodejs base image
FROM node:25-bullseye-slim

#2. Create a work directory
WORKDIR /nodeApp

#3. Copy the depency information into the directory
COPY package.json package-lock.json ./

#4. Install all the depencies
RUN npm install

#5. Copy all the code into the work directory
COPY . ./

#6. Install runtime utilities (netcat + curl)
RUN apt-get -q update \
 && apt-get -qy install netcat curl \
 && rm -rf /var/lib/apt/lists/*

#7. Copy wait-for script and make it executable
COPY wait-for /nodeApp/
RUN chmod +x /nodeApp/wait-for

#8. Docker healthcheck (LIVELINESS PROBE)
HEALTHCHECK --interval=10s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -fs http://localhost:${NODE_PORT}/portfolio/health || exit 1

#9. Set the application entry point
#CMD ["npm", "run", "serverstart"]
CMD ["npm", "run", "devstart"]
