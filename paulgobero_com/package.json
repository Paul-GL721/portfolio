{
  "name": "paulgobero-com",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=production node --require dotenv/config ./bin/www",
    "devstart": "NODE_ENV=development nodemon --require dotenv/config -L ./bin/www",
    "stagestart": "NODE_ENV=stage nodemon --require dotenv/config -L ./bin/www",
    "serverstart": "DEBUG=paulgobero-com:* npm run devstart",
    "test:server": "NODE_ENV=test nodemon --require dotenv/config -L ./bin/www",
    "test:unit": "NODE_ENV=test node ./bin/www & wait-on tcp:3002 && jest ./__tests__ --runInBand --watchAll --coverage --verbose",
    "test:unit-inside-docker": "NODE_ENV=test jest --runInBand --detectOpenHandles --verbose --coverage --bail",
    "test:e2e": "NODE_ENV=test node ./bin/www & wait-on tcp:3002 && jest --config=jest.e2e.config.js --runInBand --watchAll --coverage --verbose ",
    "test:e2e-inside-docker": "NODE_ENV=test node ./bin/www & wait-on tcp:3002 && jest --config=jest.e2e.config.js --watchAll --coverage --verbose --testPathPattern=/nodeApp/__e2e__"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.254.0",
    "@aws-sdk/s3-request-presigner": "^3.254.0",
    "async": "^3.2.4",
    "body-parser": "^1.20.1",
    "child_process": "^1.0.2",
    "cookie-parser": "~1.4.3",
    "debug": "~2.6.9",
    "express": "^4.18.2",
    "express-validator": "^6.14.2",
    "form-data": "^4.0.0",
    "http-errors": "~1.6.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.7.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.12",
    "nunjucks": "^3.2.3",
    "pug": "~3.0.2",
    "sharp": "^0.32.6",
    "sitemap": "^8.0.0"
  },
  "devDependencies": {
    "@shelf/jest-mongodb": "^4.1.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "jest": "^29.6.1",
    "jest-puppeteer": "^8.0.6",
    "mongodb": "^5.5.0",
    "mongodb-memory-server": "^8.12.2",
    "nodemon": "^3.0.1",
    "puppeteer": "^20.8.2",
    "supertest": "^6.3.3",
    "supertest-session": "^4.1.0",
    "wait-on": "^7.0.1"
  }
}